{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clipsync-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "UserRoom" }]
  },
  // SQLite-backed Durable Objects are available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clipsync",
      // Replace with the real id from `npx wrangler d1 create clipsync` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
