{
  "name": "@copyglide/desktop",
  "productName": "CopyGlide",
  "version": "0.1.0",
  "private": true,
  "description": "CopyGlide — sync your clipboard across all your devices",
  "author": "CopyGlide",
  "homepage": "https://copyglide.app",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "node build.mjs",
    "build:renderer": "npm run build -w @copyglide/web && node scripts/copy-renderer.cjs",
    "dev": "node build.mjs && electron . --dev",
    "start": "npm run build:renderer && node build.mjs && electron .",
    "dist": "npm run build:renderer && node build.mjs && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@copyglide/shared": "*",
    "@resvg/resvg-js": "^2.6.2",
    "@types/ws": "^8.18.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3",
    "ws": "^8.23.0"
  },
  "build": {
    "appId": "app.copyglide.desktop",
    "productName": "CopyGlide",
    "files": [
      "dist/**",
      "preload.cjs",
      "renderer/**",
      "assets/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "CopyGlide"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "Copy here. Paste everywhere."
    }
  }
}
